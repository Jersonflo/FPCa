# Supabase (Project Settings → API). La service_role es SECRETA: solo aquí, nunca en el frontend.
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key

# Google OAuth2 / Calendar API
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
# Local: http://localhost:3001/auth/google/callback
# Vercel: https://TU-BACKEND.vercel.app/auth/google/callback
GOOGLE_REDIRECT_URI=http://localhost:3001/auth/google/callback

# Solo estos correos de Google pueden entrar (separados por coma)
ALLOWED_EMAILS=tu-correo@gmail.com

# JWT: mínimo 32 caracteres aleatorios. Genera uno con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# URL(s) del frontend separadas por coma. La PRIMERA es a donde vuelve el login.
# Ej en Vercel: https://tu-dashboard.vercel.app,http://localhost:5173
FRONTEND_URL=http://localhost:5173

TIME_ZONE=America/Bogota
PORT=3001
